app-notifications = no-clipboard-copy
confirm-close-surface = false
copy-on-select = clipboard

font-family = IoskeleyMonoNL Nerd Font Mono
font-size = 13
adjust-cell-width = 0%
adjust-cell-height = 30%
adjust-cursor-height = 30%
adjust-underline-position = 3%
adjust-underline-thickness = -1
adjust-cursor-thickness = 1

shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

window-theme = system
cursor-style = bar
macos-titlebar-style = native
# Linux: no GTK header bar, niri draws no decorations either; macOS ignores it
gtk-titlebar = false
window-colorspace = display-p3
window-inherit-working-directory = true
window-padding-color = background
desktop-notifications = true
clipboard-paste-protection = false
background-opacity = 1.00

custom-shader = ./shaders/cursor_warp.glsl

config-file = keybind.ghostty
# The generated colours as a conditional theme, the same file for both:
# Ghostty tracks light/dark (its answer to CSI ?996n and mode 2031, which
# herdr's auto_switch reads) only for a conditional theme, and two equal
# values collapse to a plain one, hence two names. Both are links that
# `theme` puts in themes/ to ~/.config/theme/ghostty.conf: Ghostty 1.3.1
# (Arch) doesn't expand ~ in a theme path.
theme = light:dotfiles-light,dark:dotfiles-dark
