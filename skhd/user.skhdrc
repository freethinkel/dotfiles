# ─── User skhd overrides ──────────────────────────────────────────────
# Add personal keybindings here. This file is loaded after the base config.

# ─── Yabai bindings (mirrors aerospace.toml) ─────────────────────────

# layout: rotate tiles orientation (aerospace alt-slash)
alt - 0x2C : yabai -m space --rotate 90
# toggle float + always-on-top; second press returns window to tiling
alt - t : if [ "$(yabai -m query --windows --window | jq -r '."sub-layer"')" = "above" ]; then \
    yabai -m window --sub-layer normal --toggle float; \
  else \
    yabai -m window --sub-layer above --toggle float; \
  fi

# focus
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# move (swap)
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# resize smart -/+ and balance
alt - 0x1B : yabai -m window --resize right:-50:0 2>/dev/null || yabai -m window --resize left:-50:0
alt - 0x18 : yabai -m window --resize right:50:0 2>/dev/null || yabai -m window --resize left:50:0
alt - 0 : yabai -m space --balance

# workspaces (needs scripting addition, loaded in yabairc)
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5

# monitors
alt + shift - tab : yabai -m space --display next 2>/dev/null || yabai -m space --display first
ctrl + cmd - tab : yabai -m display --focus next 2>/dev/null || yabai -m display --focus first

alt - f : yabai -m window --toggle zoom-fullscreen

# toggle: float centered at 2/3 of screen <-> back to tiling
alt - c : win=$(yabai -m query --windows --window); \
  if [ "$(echo "$win" | jq -r '."is-floating"')" = "true" ]; then \
    yabai -m window --toggle float; \
  else \
    yabai -m window --toggle float --grid 1:6:1:0:4:1 --raise; \
  fi

# ─── resize mode (aerospace alt-r) ───────────────────────────────────
:: resize @
alt - r ; resize
resize < h : yabai -m window --resize right:-100:0 2>/dev/null || yabai -m window --resize left:-100:0
resize < l : yabai -m window --resize right:100:0 2>/dev/null || yabai -m window --resize left:100:0
resize < j : yabai -m window --resize bottom:0:100 2>/dev/null || yabai -m window --resize top:0:100
resize < k : yabai -m window --resize bottom:0:-100 2>/dev/null || yabai -m window --resize top:0:-100
resize < return ; default
resize < escape ; default

# ─── service mode (aerospace alt-shift-semicolon) ────────────────────
:: service @
alt + shift - 0x29 ; service
service < escape ; default
service < r : skhd --reload; yabai --restart-service
service < f : yabai -m window --toggle float; skhd -k "escape"
service < down : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 6)'
service < up : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 6)'
service < shift - down : osascript -e 'set volume output volume 0'; skhd -k "escape"
