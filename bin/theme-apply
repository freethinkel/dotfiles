#!/usr/bin/env bash
# Runtime side of a theme change: reload running apps, wallpaper, macOS appearance.
# The files themselves are generated by `theme set` into ~/.config/theme.
set -uo pipefail
T="$HOME/.config/theme"
REPO="$HOME/Developer/infra/dotfiles"
light=0; [[ -f "$T/light.mode" ]] && light=1

# macOS appearance
osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $([[ $light = 1 ]] && echo false || echo true)" 2>/dev/null || true

# GTK/libadwaita apps (nautilus): xdg-desktop-portal-gnome reads this key and
# hands the preference to them, live. dconf writes it directly — `gsettings`
# would want gsettings-desktop-schemas on XDG_DATA_DIRS, dconf needs nothing.
command -v dconf &>/dev/null && dconf write /org/gnome/desktop/interface/color-scheme \
  "'$([[ $light = 1 ]] && echo prefer-light || echo prefer-dark)'" 2>/dev/null || true

# tmux / ghostty / btop / zellij / herdr / borders
tmux list-sessions &>/dev/null && tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null || true
osascript -e 'tell application "System Events"
  repeat with p in (every process whose name is "ghostty")
    tell p to click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1
  end repeat
end tell' 2>/dev/null || true
pkill -USR2 btop 2>/dev/null || true
pkill -USR2 waybar 2>/dev/null || true
command -v qs &>/dev/null && qs ipc call theme reload &>/dev/null || true
[[ -e ~/.config/zellij/config.kdl ]] && touch ~/.config/zellij/config.kdl
"$HOME/.config/borders/on-theme-change" 2>/dev/null || true

# herdr: pick light_name/dark_name from its config, then reload
cfg="$HOME/.config/herdr/config.toml"
if [[ -f $cfg ]]; then
  key=dark_name; [[ $light = 1 ]] && key=light_name
  want="$(sed -n "s/^$key = \"\(.*\)\"/\1/p" "$cfg" | head -1)"
  # -i.bak works on both BSD and GNU sed (-i '' is BSD-only); edit the real file, GNU sed would replace the home-manager symlink
  real="$(readlink -f "$cfg")"
  [[ -n $want ]] && sed -i.bak "s/^name = \".*\"/name = \"$want\"/" "$real" && rm -f "$real.bak"
  # base theme above fills whatever tokens herdr.toml doesn't set; swap our block in place
  if [[ -f $T/herdr.toml ]]; then
    tmp="$(mktemp)"
    awk '/^# >>> theme colors/{skip=1} !skip{print} /^# <<< theme colors/{skip=0}' "$real" > "$tmp"
    cat "$T/herdr.toml" >> "$tmp" && cat "$tmp" > "$real"; rm -f "$tmp"
  fi
  command -v herdr &>/dev/null && herdr server reload-config &>/dev/null || true
fi

# Chromium browsers: managed theme color
bg="$(sed -n 's/^background = "\(#[^"]*\)".*/\1/p' "$T/colors.toml" | head -1)"
if [[ -n $bg ]]; then
  scheme=dark; [[ $light = 1 ]] && scheme=light
  for id in com.google.Chrome com.brave.Browser org.chromium.Chromium com.microsoft.Edge; do
    mdfind "kMDItemCFBundleIdentifier == '$id'" 2>/dev/null | grep -q . || continue
    defaults write "$id" BrowserThemeColor -string "$bg"
    defaults write "$id" BrowserColorScheme -string "$scheme"
  done
fi

# Obsidian: drop generated css into every vault as the "Omarchy" theme
if [[ -f "$T/obsidian.css" ]] && command -v jq &>/dev/null; then
  for json in "$HOME/Library/Application Support/obsidian/obsidian.json" "$HOME/.config/obsidian/obsidian.json"; do
    [[ -f $json ]] || continue
    jq -r '.vaults | values[].path' "$json" 2>/dev/null | while IFS= read -r vault; do
      [[ -d "$vault/.obsidian" ]] || continue
      mkdir -p "$vault/.obsidian/themes/Omarchy"
      [[ -f "$vault/.obsidian/themes/Omarchy/manifest.json" ]] || printf '{"name":"Omarchy","version":"1.0.0","minAppVersion":"0.16.0","description":"Follows the active nix theme.","author":"nix"}\n' > "$vault/.obsidian/themes/Omarchy/manifest.json"
      cp "$T/obsidian.css" "$vault/.obsidian/themes/Omarchy/theme.css"
    done
    break
  done
fi

rm -f "$HOME/.cache/wallpaper_index"
"$REPO/bin/wallpaper" next 2>/dev/null || true
