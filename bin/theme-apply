#!/usr/bin/env bash
# Runtime side of a theme change: reload running apps, wallpaper, macOS appearance.
# The files themselves are generated by `theme set` into ~/.config/theme.
set -uo pipefail
T="$HOME/.config/theme"
BIN="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
light=0; [[ -f "$T/light.mode" ]] && light=1

# macOS appearance
osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $([[ $light = 1 ]] && echo false || echo true)" 2>/dev/null || true

# tmux / ghostty / btop / herdr
tmux list-sessions &>/dev/null && tmux source-file ~/.config/tmux/tmux.conf 2>/dev/null || true
osascript -e 'tell application "System Events"
  repeat with p in (every process whose name is "ghostty")
    tell p to click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1
  end repeat
end tell' 2>/dev/null || true
pkill -USR2 btop 2>/dev/null || true

# herdr: pick light_name/dark_name from its config, then reload
cfg="$HOME/.config/herdr/config.toml"
if [[ -f $cfg ]]; then
  key=dark_name; [[ $light = 1 ]] && key=light_name
  want="$(sed -n "s/^$key = \"\(.*\)\"/\1/p" "$cfg" | head -1)"
  # the config is a stow symlink: write through it so the link survives
  real="$(readlink -f "$cfg")"
  # set name only inside [theme], drop our old colour block; the base theme fills
  # whatever tokens herdr.toml doesn't set
  tmp="$(mktemp)"
  awk -v want="$want" '
    /^# >>> theme colors/ { skip = 1 }
    !skip {
      if (/^\[/) sec = $0
      if (sec == "[theme]" && want != "" && /^name = /) $0 = "name = \"" want "\""
      print
    }
    /^# <<< theme colors/ { skip = 0 }' "$real" > "$tmp"
  [[ -f $T/herdr.toml ]] && cat "$T/herdr.toml" >> "$tmp"
  [[ -s $tmp ]] && cat "$tmp" > "$real"; rm -f "$tmp"
  command -v herdr &>/dev/null && herdr server reload-config &>/dev/null || true
fi

# Chromium browsers: managed theme color
bg="$(sed -n 's/^background = "\(#[^"]*\)".*/\1/p' "$T/colors.toml" | head -1)"
if [[ -n $bg ]]; then
  scheme=dark; [[ $light = 1 ]] && scheme=light
  for id in com.google.Chrome com.brave.Browser org.chromium.Chromium com.microsoft.Edge; do
    mdfind "kMDItemCFBundleIdentifier == '$id'" 2>/dev/null | grep -q . || continue
    defaults write "$id" BrowserThemeColor -string "$bg"
    defaults write "$id" BrowserColorScheme -string "$scheme"
  done
fi

# Obsidian: drop generated css into every vault as the "Omarchy" theme (name kept so vaults stay selected)
json="$HOME/Library/Application Support/obsidian/obsidian.json"
if [[ -f "$T/obsidian.css" && -f $json ]] && command -v jq &>/dev/null; then
  jq -r '.vaults | values[].path' "$json" 2>/dev/null | while IFS= read -r vault; do
    [[ -d "$vault/.obsidian" ]] || continue
    mkdir -p "$vault/.obsidian/themes/Omarchy"
    [[ -f "$vault/.obsidian/themes/Omarchy/manifest.json" ]] || printf '{"name":"Omarchy","version":"1.0.0","minAppVersion":"0.16.0","description":"Follows the active dotfiles theme.","author":"dotfiles"}\n' > "$vault/.obsidian/themes/Omarchy/manifest.json"
    cp "$T/obsidian.css" "$vault/.obsidian/themes/Omarchy/theme.css"
  done
fi

rm -f "$HOME/.cache/wallpaper_index"
"$BIN/wallpaper" next 2>/dev/null || true
