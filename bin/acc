#!/usr/bin/env bash
#
# Pitsos AC control via Home Connect API
#
# Setup:
#   1. Register app at https://developer.home-connect.com/
#   2. Export HC_CLIENT_ID and HC_CLIENT_SECRET
#   3. Run: acc authorize
#   4. Run: acc list  (to find your haId's)
#   5. Run: acc on <haId>  /  acc off <haId>
#

set -euo pipefail

# Source .env if present
for f in "$HOME/.env" "$(dirname "$0")/../.env"; do
    [[ -f "$f" ]] && set -a && source "$f" && set +a && break
done

CLIENT_ID="$(echo "${HC_CLIENT_ID:-}" | xargs)"
CLIENT_SECRET="$(echo "${HC_CLIENT_SECRET:-}" | xargs)"
REDIRECT_URI="${HC_REDIRECT_URI:-http://localhost:8080}"
TOKEN_FILE="${HC_TOKEN_FILE:-$HOME/.homeconnect_tokens.json}"
BASE_URL="${HC_BASE_URL:-https://api.home-connect.com}"
CT="application/vnd.bsh.sdk.v1+json"

# --- json helpers: values go in through argv/stdin, never spliced into code ---

# json_get <key> [default] < json
json_get() {
    python3 -c 'import sys, json; print(json.load(sys.stdin).get(sys.argv[1], sys.argv[2]))' "$1" "${2:-}" 2>/dev/null
}

# connected haIds, one per line
connected_ids() {
    api GET "" | python3 -c "
import sys, json
for a in json.load(sys.stdin).get('data',{}).get('homeappliances',[]):
    if a.get('connected'): print(a['haId'])"
}

# --- token helpers ---

save_tokens() {
    # ponytail: an empty token here is what silently poisons the file and
    # makes every later call 401 with no explanation.
    [[ -n "$1" ]] || { echo "Refused to save an empty access token." >&2; exit 1; }
    [[ "${3:-}" =~ ^[0-9]+$ ]] || set -- "$1" "$2" 86400
    (umask 077; python3 -c '
import sys, json, time
at, rt, exp, path = sys.argv[1:]
json.dump({"access_token": at, "refresh_token": rt, "expires_at": int(time.time()) + int(exp)}, open(path, "w"))
' "$1" "$2" "$3" "$TOKEN_FILE")
    chmod 600 "$TOKEN_FILE"
}

get_token() {
    [[ -f "$TOKEN_FILE" ]] || { echo "Run: $0 authorize" >&2; exit 1; }

    local expires_at access_token refresh_token
    {
        read -r expires_at
        read -r access_token
        read -r refresh_token
    } < <(python3 -c '
import sys, json
d = json.load(open(sys.argv[1]))
print(int(d.get("expires_at", 0)))
print(d.get("access_token", ""))
print(d.get("refresh_token", ""))
' "$TOKEN_FILE") || true
    [[ "$expires_at" =~ ^[0-9]+$ ]] || expires_at=0

    if [[ -z "$access_token" ]] || (( $(date +%s) >= expires_at )); then
        [[ -n "$CLIENT_ID" && -n "$CLIENT_SECRET" ]] || {
            echo "Token needs a refresh but HC_CLIENT_ID/HC_CLIENT_SECRET are unset." >&2
            exit 1
        }
        local resp
        [[ -n "$refresh_token" ]] || { echo "No refresh token saved. Run: $0 authorize" >&2; exit 1; }
        resp=$(curl -sS --fail-with-body -X POST "${BASE_URL}/security/oauth/token" \
            --data-urlencode "grant_type=refresh_token" \
            --data-urlencode "refresh_token=${refresh_token}" \
            --data-urlencode "client_id=${CLIENT_ID}" \
            --data-urlencode "client_secret=${CLIENT_SECRET}") || true

        access_token=$(json_get access_token <<<"$resp")
        [[ -n "$access_token" ]] || {
            echo "Refresh failed: $resp" >&2
            echo "Run: $0 authorize" >&2
            exit 1
        }
        local new_rt
        new_rt=$(json_get refresh_token <<<"$resp")
        [[ -n "$new_rt" && "$new_rt" != "None" ]] && refresh_token="$new_rt"
        local exp
        exp=$(json_get expires_in 86400 <<<"$resp")
        save_tokens "$access_token" "$refresh_token" "$exp"
        echo >&2 "Token refreshed."
    fi

    echo "$access_token"
}

api() {
    local method="$1" path="$2" token
    shift 2
    # a failing $(...) inside curl's args would not stop set -e: fetch it first
    token=$(get_token) || exit 1
    curl -sS --fail-with-body -X "$method" "${BASE_URL}/api/homeappliances${path}" \
        -H "Authorization: Bearer ${token}" \
        -H "Accept: $CT" \
        -H "Content-Type: $CT" \
        "$@"
}

# Pick an appliance with fzf when no haId is given, like `theme set`.
pick_ha() {
    command -v fzf >/dev/null || { echo "Usage: acc $1 <haId>" >&2; exit 1; }
    api GET "" | python3 -c "
import sys, json
for a in json.load(sys.stdin).get('data', {}).get('homeappliances', []):
    status = 'connected' if a.get('connected') else 'offline'
    print(f\"{a['haId']}\t{a.get('name', a.get('type','?'))}  [{status}]\")" |
        fzf --prompt='AC: ' --height=~20 --delimiter='\t' --with-nth=2 | cut -f1
}

# --- commands ---

cmd_authorize() {
    [[ -z "$CLIENT_ID" ]] && { echo "Set HC_CLIENT_ID" >&2; exit 1; }

    local query
    query=$(python3 -c '
import sys, urllib.parse
print(urllib.parse.urlencode({"response_type": "code", "client_id": sys.argv[1], "redirect_uri": sys.argv[2],
                              "scope": "IdentifyAppliance Monitor Control Settings"}, quote_via=urllib.parse.quote))
' "$CLIENT_ID" "$REDIRECT_URI")

    echo "Open this URL in your browser:"
    echo ""
    echo "${BASE_URL}/security/oauth/authorize?${query}"
    echo ""
    read -rp "Paste the authorization code: " code

    local resp
    resp=$(curl -sS --fail-with-body -X POST "${BASE_URL}/security/oauth/token" \
        --data-urlencode "grant_type=authorization_code" \
        --data-urlencode "code=${code}" \
        --data-urlencode "client_id=${CLIENT_ID}" \
        --data-urlencode "client_secret=${CLIENT_SECRET}" \
        --data-urlencode "redirect_uri=${REDIRECT_URI}") || { echo "Token request failed: $resp" >&2; exit 1; }

    local at rt exp
    at=$(json_get access_token <<<"$resp")
    rt=$(json_get refresh_token <<<"$resp")
    exp=$(json_get expires_in 86400 <<<"$resp")
    save_tokens "$at" "$rt" "$exp"
    echo "Authorized. Tokens saved to $TOKEN_FILE"
}

cmd_list() {
    echo "Connected appliances:"
    api GET "" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for a in data.get('data', {}).get('homeappliances', []):
    status = 'connected' if a.get('connected') else 'offline'
    print(f\"  {a['haId']}  {a.get('name', a.get('type','?'))}  [{status}]\")
"
}

cmd_status() {
    local ha_id="${1:-}"
    [[ -n "$ha_id" ]] || ha_id=$(pick_ha status) || exit 0
    api GET "/${ha_id}/status" | python3 -c "
import sys, json
for s in json.load(sys.stdin).get('data', {}).get('status', []):
    print(f\"  {s['key'].split('.')[-1]}: {s['value']}\")"
}

cmd_on() {
    local ha_id="${1:-}"
    [[ -n "$ha_id" ]] || ha_id=$(pick_ha on) || exit 0
    api PUT "/${ha_id}/settings/BSH.Common.Setting.PowerState" \
        -d '{"data":{"key":"BSH.Common.Setting.PowerState","value":"BSH.Common.EnumType.PowerState.On","type":"BSH.Common.EnumType.PowerState"}}'
    echo "ON: ${ha_id}"
}

cmd_off() {
    local ha_id="${1:-}"
    [[ -n "$ha_id" ]] || ha_id=$(pick_ha off) || exit 0
    # ACs use Standby, not Off
    api PUT "/${ha_id}/settings/BSH.Common.Setting.PowerState" \
        -d '{"data":{"key":"BSH.Common.Setting.PowerState","value":"BSH.Common.EnumType.PowerState.Standby","type":"BSH.Common.EnumType.PowerState"}}'
    echo "OFF: ${ha_id}"
}

cmd_on_all() {
    local ids ha_id
    ids=$(connected_ids) || exit 1
    for ha_id in $ids; do cmd_on "$ha_id"; done
}

cmd_off_all() {
    local ids ha_id
    ids=$(connected_ids) || exit 1
    for ha_id in $ids; do cmd_off "$ha_id"; done
}

get_power_state() {
    local ha_id="$1"
    api GET "/${ha_id}/settings/BSH.Common.Setting.PowerState" | python3 -c "
import sys, json
print(json.load(sys.stdin)['data']['value'].split('.')[-1])"
}

cmd_toggle() {
    local ha_id="${1:-}"
    [[ -n "$ha_id" ]] || ha_id=$(pick_ha toggle) || exit 0
    local state
    state=$(get_power_state "$ha_id")
    if [[ "$state" == "On" ]]; then
        cmd_off "$ha_id"
    else
        cmd_on "$ha_id"
    fi
}

cmd_toggle_all() {
    local ids ha_id
    ids=$(connected_ids) || exit 1
    for ha_id in $ids; do cmd_toggle "$ha_id"; done
}

# --- main ---

case "${1:-}" in
    authorize)  cmd_authorize ;;
    list)       cmd_list ;;
    status)     cmd_status "${2:-}" ;;
    on)         cmd_on "${2:-}" ;;
    off)        cmd_off "${2:-}" ;;
    on-all)     cmd_on_all ;;
    off-all)    cmd_off_all ;;
    toggle)     cmd_toggle "${2:-}" ;;
    toggle-all) cmd_toggle_all ;;
    *)
        cat <<USAGE
Usage: acc <command> [haId]

  authorize    OAuth2 setup (one-time)
  list         Show connected appliances
  status [ID]  Show appliance status
  on [ID]      Turn ON
  off [ID]     Turn OFF (standby)
  toggle [ID]  Toggle ON/OFF
               (no ID: pick with fzf)
  on-all       Turn ON all connected
  off-all      Turn OFF all connected
  toggle-all   Toggle all connected

Setup:
  export HC_CLIENT_ID="your_client_id"
  export HC_CLIENT_SECRET="your_client_secret"
  acc authorize
  acc list
  acc on-all
USAGE
    ;;
esac
