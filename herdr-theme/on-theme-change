#!/bin/bash
# slicker theme hook: переключить тему herdr вслед за светлой/тёмной slicker-темой.
#
# Штатный herdr auto_switch тут не работает: он ждёт, что о смене оформления
# сообщит терминал, а палитра ghostty прибита сгенерированным slicker
# ghostty.conf и между светлой и тёмной не переключается. Так что берём тот же
# признак, по которому slicker сам выставляет appearance macOS — файл-флаг
# light.mode активной темы, — и пишем в herdr имя темы напрямую.
#
# Живёт в отдельной директории, а не в user/herdr/: is_stow_pkg считает
# пакетом только каталог из одних dot-entries, и любой обычный файл рядом
# с .config/ выкинул бы herdr из stow.
set -euo pipefail

config="$HOME/.config/herdr/config.toml"
[[ -f $config ]] || exit 0

if [[ -f "$HOME/.config/slicker/theme/light.mode" ]]; then
  want="$(sed -n 's/^light_name = "\(.*\)"/\1/p' "$config" | head -1)"
else
  want="$(sed -n 's/^dark_name = "\(.*\)"/\1/p' "$config" | head -1)"
fi
[[ -n $want ]] || exit 0

current="$(sed -n 's/^name = "\(.*\)"/\1/p' "$config" | head -1)"
[[ $current == "$want" ]] && exit 0

# Пишем содержимое через cat, а не sed -i: тот заменяет файл новым и снёс бы
# симлинк, которым config.toml приходит из dotfiles.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
sed "s/^name = \".*\"/name = \"$want\"/" "$config" >"$tmp"
cat "$tmp" >"$config"

command -v herdr &>/dev/null && herdr server reload-config &>/dev/null || true
