<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.freethinkel.statusbar</string>
  <key>CFBundleName</key><string>statusbar</string>
  <!-- This file is BOTH the section embedded in the binary and the
       bundle's Contents/Info.plist, so the usage strings have one home. -->
  <key>CFBundleExecutable</key><string>statusbar</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSUIElement</key><true/>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>statusbar uses your position only to fetch the local weather.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>statusbar marks the clock when you have events today and opens their call links.</string>
  <!-- Home Assistant over plain http on the LAN -->
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>statusbar talks to Home Assistant on your local network to show and control your devices.</string>
</dict>
</plist>
