#!/bin/bash
# Active border color follows the current slicker theme accent.

accent=$(grep '^accent' "$HOME/.config/slicker/theme/colors.toml" 2>/dev/null | sed 's/.*"#\([^"]*\)".*/\1/')

# Boost saturation (and cap lightness) so pastel accents stay visible as a border
accent=$(python3 - "${accent:-f2fcff}" <<'EOF'
import colorsys, sys
hex_ = sys.argv[1]
r, g, b = (int(hex_[i:i + 2], 16) / 255 for i in (0, 2, 4))
h, l, s = colorsys.rgb_to_hls(r, g, b)
r, g, b = colorsys.hls_to_rgb(h, min(l, 0.65), max(s, 0.85))
print(''.join(f'{round(c * 255):02x}' for c in (r, g, b)))
EOF
)

options=(
  style=round
  width=7.5
  hidpi=on
  active_color="0xff${accent}"
  inactive_color=0x00000000
  blacklist="Simulator"
)

borders "${options[@]}"
