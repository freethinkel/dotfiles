.DS_Store
.env
.claude/settings.local.json
# links made by bin/theme (~/.config/ghostty is a folded stow dir)
ghostty/.config/ghostty/themes/
waybar/.config/waybar/theme.css
# tpm installs plugins here
tmux/.config/tmux/plugins/
# nvim runtime junk
nvim/.config/nvim/.tests
nvim/.config/nvim/.repro
nvim/.config/nvim/*.log
nvim/.config/nvim/data
# antidote static bundle, generated per machine
zsh/.config/zsh/plugins.zsh
# synced from claude.ai, contains account ids
claude/.claude/skills/synced/
# downloaded palettes stay local, only ours are tracked
themes/*
!themes/snowfall*
!themes/templates
# generated by theme-apply from ~/.config/theme/slack.css
slack/theme.css
