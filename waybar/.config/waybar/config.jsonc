// Waybar on niri, laid out like statusbar/statusbar.swift: one solid strip,
// workspace chips on the left, media in the middle, icon+label pills on the right.
// Glyphs are Nerd Font icons at 15pt: the Mono font squeezes them into one cell,
// so 16px (the Swift bar's ICON_SIZE) drew them smaller than the 13px text.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": ["custom/logo", "niri/workspaces"],
  "modules-center": ["mpris"],
  // DEFAULT_ORDER, minus the macOS-only and network pills (claude, weather, home, tailscale, theme, agents)
  "modules-right": ["group/more", "custom/layout", "backlight", "pulseaudio", "battery", "clock", "cpu"],

  // the apple pill's place: accent glyph, opens the launcher
  "custom/logo": {
    "format": "<span size='17pt' rise='-2pt'></span>",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "niri/workspaces": {
    "format": "{index}"
  },

  "mpris": {
    "format": "{status_icon} {artist} – {title}",
    "status-icons": { "playing": "<span size='17pt' rise='-2pt'></span>", "paused": "<span size='17pt' rise='-2pt'></span>", "stopped": "<span size='17pt' rise='-2pt'></span>" },
    "title-len": 40,
    "artist-len": 24,
    "on-click": "playerctl play-pause"
  },

  // whatever sits left of the chevron hides behind it until clicked
  "group/more": {
    "orientation": "horizontal",
    "drawer": { "click-to-reveal": true, "transition-left-to-right": false, "transition-duration": 200 },
    "modules": ["custom/more", "idle_inhibitor", "tray"]
  },
  "custom/more": { "format": "<span size='17pt' rise='-2pt'></span>", "tooltip": false },
  // caffeinate
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "<span size='17pt' rise='-2pt'></span>", "deactivated": "<span size='17pt' rise='-2pt'></span>" }
  },
  "tray": { "icon-size": 16, "spacing": 8 },

  // drawn as a keycap in style.css
  "custom/layout": {
    "exec": "~/.config/waybar/layout.sh",
    "tooltip": false,
    "on-click": "niri msg action switch-layout next"
  },

  "backlight": {
    "format": "<span size='17pt' rise='-2pt'></span> {percent}%",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "<span size='17pt' rise='-2pt'>󰖁</span> mute",
    "format-icons": { "headphone": "<span size='17pt' rise='-2pt'>󰋋</span>", "headset": "<span size='17pt' rise='-2pt'>󰋋</span>", "default": ["<span size='17pt' rise='-2pt'>󰕿</span>", "<span size='17pt' rise='-2pt'>󰖀</span>", "<span size='17pt' rise='-2pt'>󰕾</span>"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  // states are "at or below": high 90-100 green, warning 10-29 yellow, critical <10 red
  "battery": {
    "states": { "high": 100, "normal": 89, "warning": 29, "critical": 9 },
    "format": "{icon} {capacity}%",
    "format-charging": "<span size='17pt' rise='-2pt'></span> {capacity}%",
    "format-full": "<span size='17pt' rise='-2pt'></span>",
    "format-icons": ["<span size='17pt' rise='-2pt'></span>", "<span size='17pt' rise='-2pt'></span>", "<span size='17pt' rise='-2pt'></span>", "<span size='17pt' rise='-2pt'></span>", "<span size='17pt' rise='-2pt'></span>"],
    "tooltip-format": "{timeTo}"
  },

  "clock": {
    "format": "<span size='17pt' rise='-2pt'></span> {:%d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "weeks-pos": "", "format": { "today": "<b><u>{}</u></b>" } }
  },

  // activity: a quiet glyph that only speaks up when the cpu is busy
  "cpu": {
    "interval": 60,
    "states": { "hot": 80 },
    "format": "<span size='17pt' rise='-2pt'></span>",
    "format-hot": "<span size='17pt' rise='-2pt'></span> {usage}%",
    "tooltip": false,
    "on-click": "ghostty -e btop"
  }
}
