// Waybar on niri, laid out like statusbar/statusbar.swift: one solid strip,
// workspace chips on the left, media in the middle, icon+label pills on the right.
// Glyphs are Nerd Font escapes so the file survives any editor.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": ["custom/logo", "niri/workspaces"],
  "modules-center": ["mpris"],
  // DEFAULT_ORDER, minus the macOS-only and network pills (claude, weather, home, tailscale, theme, agents)
  "modules-right": ["group/more", "niri/language", "backlight", "pulseaudio", "battery", "clock", "cpu"],

  // the apple pill's place: accent glyph, opens the launcher
  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "niri/workspaces": {
    "format": "{index}"
  },

  "mpris": {
    "format": "{status_icon} {artist} – {title}",
    "status-icons": { "playing": "", "paused": "", "stopped": "" },
    "title-len": 40,
    "artist-len": 24,
    "on-click": "playerctl play-pause"
  },

  // whatever sits left of the chevron hides behind it until clicked
  "group/more": {
    "orientation": "horizontal",
    "drawer": { "click-to-reveal": true, "transition-left-to-right": false, "transition-duration": 200 },
    "modules": ["custom/more", "idle_inhibitor", "tray"]
  },
  "custom/more": { "format": "", "tooltip": false },
  // caffeinate
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" }
  },
  "tray": { "icon-size": 16, "spacing": 8 },

  // drawn as a keycap in style.css
  "niri/language": {
    "format": "{short}",
    "format-en": "EN",
    "format-ru": "RU",
    "on-click": "niri msg action switch-layout next"
  },

  "backlight": {
    "format": " {percent}%",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " mute",
    "format-icons": { "headphone": "", "headset": "", "default": ["", "", ""] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  // states are "at or below": high 90-100 green, warning 10-29 yellow, critical <10 red
  "battery": {
    "states": { "high": 100, "normal": 89, "warning": 29, "critical": 9 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-full": "",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  },

  "clock": {
    "format": " {:%d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "weeks-pos": "", "format": { "today": "<b><u>{}</u></b>" } }
  },

  // activity: a quiet glyph that only speaks up when the cpu is busy
  "cpu": {
    "interval": 60,
    "states": { "hot": 80 },
    "format": "",
    "format-hot": " {usage}%",
    "tooltip": false,
    "on-click": "ghostty -e btop"
  }
}
